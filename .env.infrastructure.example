# NearLink 共享基础设施环境变量模板（MySQL + Redis）
#
# 配置位置：服务器 /opt/shared-services/.env.infrastructure
# 创建方式：cp .env.infrastructure.example /opt/shared-services/.env.infrastructure && chmod 600 /opt/shared-services/.env.infrastructure
# 注意：真实密码不得提交到 Git。该文件由服务器管理员维护，应用开发者通常不需要持有生产密码。
# 首次创建数据卷后，修改 INITIAL_DB_* 不会自动修改 MySQL 中已有的账号或密码；轮换密码必须同时在数据库内执行变更。

# [必填：MySQL root 密码] 自行生成，只用于基础设施管理，不要填到 NearLink 的 DB_PASSWORD。
# 生成方式：在可信终端执行 `openssl rand -base64 36`。
MYSQL_ROOT_PASSWORD=change-me-root-password

# [必填：NearLink 初始数据库与普通账号]
# INITIAL_DB_NAME/INITIAL_DB_USER 是团队约定值；INITIAL_DB_PASSWORD 使用 `openssl rand -base64 36` 单独生成。
# 这三个值必须分别同步到 /opt/todesk/.env.production 的 DB_NAME、DB_USER、DB_PASSWORD。
INITIAL_DB_NAME=todesk
INITIAL_DB_USER=todesk
INITIAL_DB_PASSWORD=change-me-initial-db-password

# [必填：Redis 密码] 自行生成，并同步到 /opt/todesk/.env.production 的 REDIS_PASSWORD。
# 生成方式：在可信终端执行 `openssl rand -base64 36`。
REDIS_PASSWORD=change-me-redis-password
