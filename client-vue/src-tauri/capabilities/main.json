{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "主窗口允许窗口拖动、通知与用户选择的文件保存操作",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "notification:default",
    "dialog:allow-save",
    "fs:allow-write-file",
    "core:window:allow-start-dragging",
    "allow-remote-control-capabilities",
    "allow-remote-control-open-permission-settings",
    "allow-remote-control-stop",
    "allow-remote-control-register-device",
    "allow-remote-control-confirm-request",
    "allow-remote-control-clear-remembered-approvals",
    "allow-remote-control-list-remembered-approvals",
    "allow-remote-control-remove-remembered-approval",
    "allow-remote-control-reset-identity",
    "allow-remote-control-presence",
    "allow-remote-control-start-host",
    "allow-remote-control-host-command"
  ]
}
