{
  "name": "client-vue",
  "private": true,
  "version": "0.5.0-beta.12",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "vue-tsc -b",
    "build": "node ../scripts/product-version.mjs check && vue-tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "node ../scripts/product-version.mjs check && tauri build",
    "desktop:check": "tauri info",
    "desktop:web:dev": "vite --config vite.desktop.config.ts --mode desktop",
    "desktop:web:build": "node ../scripts/product-version.mjs check && vue-tsc -b && vite build --config vite.desktop.config.ts --mode desktop"
  },
  "dependencies": {
    "@mediapipe/selfie_segmentation": "0.1.1675465747",
    "@sycsq/common": "^0.0.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@vicons/ionicons5": "^0.13.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "socket.io-client": "^4.8.1",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "2.11.5",
    "@types/node": "^24.6.0",
    "@vicons/fluent": "^0.13.0",
    "@vicons/material": "^0.13.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.8.1",
    "jsdom": "^29.1.1",
    "less": "^4.4.2",
    "naive-ui": "^2.43.1",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.1.7",
    "vite-plugin-compression": "0.5.1",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.1.0"
  }
}
