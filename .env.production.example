# NearLink 生产应用环境变量模板
#
# 配置位置：服务器 /opt/todesk/.env.production
# 创建方式：cp .env.production.example /opt/todesk/.env.production && chmod 600 /opt/todesk/.env.production
# 注意：真实密码、AccessKey、SecretKey 和 SMTP 授权码不得提交到 Git，也不要发到群聊。
# 多人协作时只共享变量名和申请路径；真实值由服务器管理员写入生产服务器。
#
# GitHub Actions 使用的配置不写在本文件中，应在仓库 Settings > Secrets and variables > Actions 配置：
# - Secrets：DOCKERHUB_USERNAME、DOCKERHUB_TOKEN、SERVER_HOST、SERVER_USER、SERVER_SSH_KEY、SERVER_SSH_FINGERPRINT
# - Variables（可选）：DOCKERHUB_NAMESPACE、BACKEND_IMAGE、WEB_IMAGE、CADDY_IMAGE、CERT_SYNC_IMAGE
# 获取方式：Docker Hub 用户名/访问令牌来自 Docker Hub；服务器地址、SSH 用户、私钥和主机指纹来自 ECS/服务器管理员。

# [固定运行参数] 项目生产环境固定值，一般无需修改。
NODE_ENV=production
PORT=3000

# [必填：公网域名] 只填域名，不带 http://、https:// 或路径。
# 获取方式：填写已购买并完成备案/解析的主站域名；其 A/AAAA 记录应指向部署服务器。
DOMAIN=desk.example.com

# [必填：七牛 CDN 域名] 填写在七牛对象存储空间中绑定的两个 CDN 加速域名。
# 获取方式：七牛云控制台 > 对象存储 > 空间管理 > 域名管理；DNS 中的 CNAME 必须保持指向七牛提供的 qiniudns.com 地址。
FILES_DOMAIN=files.example.com
PRIVATE_FILES_DOMAIN=private-files.example.com

# [必填：七牛凭据] 供后端上传/删除对象、生成私有下载地址，以及证书同步器更新 CDN 证书。
# 获取方式：七牛云控制台 > 个人中心 > 密钥管理。建议使用专用、可轮换的账号密钥。
# 安全要求：只写入服务器 .env.production，不能写入前端环境变量。
QINIU_ACCESS_KEY=change-me-qiniu-access-key
QINIU_SECRET_KEY=change-me-qiniu-secret-key

# [可选：同步频率] 单位为秒。默认每 6 小时检查一次，失败后每 5 分钟重试。
# 获取方式：无需外部申请；没有明确运维需求时保留默认值。
CERT_SYNC_INTERVAL_SECONDS=21600
CERT_SYNC_RETRY_SECONDS=300

# [必填：AliDNS 凭据] 仅供 Caddy 使用 DNS-01 验证并自动签发/续期证书。
# 获取方式：阿里云 RAM 控制台创建专用用户及 AccessKey，并绑定仅允许管理目标域名 DNS 记录的最小权限策略。
# AccessKeySecret 只在创建时显示一次，应立即保存到密码管理器；丢失后需重新创建 AccessKey。
ALIYUN_ACCESS_KEY_ID=change-me-alidns-access-key-id
ALIYUN_ACCESS_KEY_SECRET=change-me-alidns-access-key-secret

# [必填：共享 Docker 网络] 必须与 docker-compose.infrastructure.yml 创建的网络名称一致。
# 获取方式：默认使用 shared-services；只有基础设施部署时修改过网络名才需要同步修改。
SHARED_SERVICES_NETWORK=shared-services

# [必填：MySQL] DB_NAME、DB_USER、DB_PASSWORD 必须与 /opt/shared-services/.env.infrastructure
# 中的 INITIAL_DB_NAME、INITIAL_DB_USER、INITIAL_DB_PASSWORD 分别保持一致。
# DB_HOST/DB_PORT 来自共享基础设施 Compose 的服务别名和容器端口，默认无需修改。
DB_HOST=shared-mysql
DB_PORT=3306
DB_NAME=todesk
DB_USER=todesk
DB_PASSWORD=change-me-todesk-db-password

# [可选：数据库初始化行为] 生产环境保持 false；表结构变更应通过明确的迁移流程执行。
DB_AUTO_CREATE=false
DB_SYNC_ALTER=false
DB_LOGGING=false

# [必填：Redis] REDIS_PASSWORD 必须与 /opt/shared-services/.env.infrastructure 中的同名变量一致。
# REDIS_HOST/REDIS_PORT 来自共享基础设施 Compose；REDIS_DB 是 NearLink 使用的逻辑库编号。
REDIS_HOST=shared-redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_DB=1

# [必填：JWT 密钥] 两个值必须不同，且部署后不要随意更换；更换会使现有登录令牌失效。
# 生成方式：在可信终端分别执行两次 `openssl rand -hex 32`，每次输出填写一个变量。
JWT_SECRET=change-me-with-a-long-random-secret
REFRESH_TOKEN_SECRET=change-me-with-another-long-random-secret

# [必填：验证码邮件] 以下示例使用 QQ 邮箱。
# 获取方式：QQ 邮箱网页版 > 设置 > 账号与安全 > 开启 SMTP 服务并生成授权码。
# SMTP_PASSWORD 填授权码，不是 QQ 登录密码；SMTP_FROM 中的邮箱通常与 SMTP_USER 相同。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-account@qq.com
SMTP_PASSWORD=change-me-qq-mail-authorization-code
SMTP_FROM=NearLink <your-account@qq.com>

# [可选：远控] 默认不开放；预览账号用于实际产品联调，最多 20 个逗号分隔的用户 ID。
REMOTE_CONTROL_PREVIEW_USER_IDS=
# 默认 rest 使用 coturn use-auth-secret；老视频 TURN 可显式使用 static，绝不自动降级。
REMOTE_TURN_AUTH_MODE=rest
REMOTE_TURN_SHARED_SECRET=
REMOTE_TURN_URLS=turn:turn.sycsq.top:3478?transport=udp,turn:turn.sycsq.top:3478?transport=tcp
REMOTE_STUN_URL=stun:turn.sycsq.top:3478
REMOTE_ICE_TRANSPORT_POLICY=all
# static 模式仅在服务器填入已有 TURN 的账号/密码；静态密码不会随远控会话过期。
REMOTE_TURN_USERNAME=
REMOTE_TURN_PASSWORD=
# Ed25519 独立密钥，私钥仅留服务器。notBefore/notAfter 使用 Unix 毫秒。
REMOTE_CONTROL_SIGNING_KEY_ID=
REMOTE_CONTROL_SIGNING_PRIVATE_KEY=
REMOTE_CONTROL_SIGNING_KEY_NOT_BEFORE=
REMOTE_CONTROL_SIGNING_KEY_NOT_AFTER=
