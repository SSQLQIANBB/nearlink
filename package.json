{
  "name": "nearlink",
  "version": "0.12.0-alpha.3",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "pnpm version:check && pnpm test:release && pnpm --filter backend-koa test && pnpm --filter client-vue test",
    "typecheck": "pnpm --filter backend-koa typecheck && pnpm --filter client-vue typecheck",
    "env:check": "pnpm --filter backend-koa env:check",
    "server": "pnpm --filter backend-koa dev",
    "client": "pnpm --filter client-vue dev",
    "desktop:dev": "node scripts/remote-control-desktop-dev.mjs",
    "desktop:dev:chat": "pnpm --filter client-vue desktop:dev:chat",
    "desktop:remote:dev": "node scripts/remote-control-desktop-build.mjs --dev",
    "desktop:remote:build": "node scripts/remote-control-desktop-build.mjs",
    "desktop:build": "pnpm --filter client-vue desktop:build",
    "desktop:build:chat": "pnpm --filter client-vue desktop:build:chat",
    "desktop:check": "pnpm --filter client-vue desktop:check",
    "version:check": "node scripts/product-version.mjs check",
    "version:sync": "node scripts/product-version.mjs sync",
    "version:set": "node scripts/product-version.mjs set",
    "test:release": "node --test scripts/product-version.test.mjs scripts/desktop-release.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "uuid": "^13.0.0"
  },
  "desktopBuildNumber": 48,
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
