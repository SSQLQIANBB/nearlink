    "@types/qs": "^6.14.0",
    "@types/request": "^2.48.13",
    "@types/sequelize": "^6.12.0",
    "chalk": "^5.6.2",
    "eslint": "^9.38.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "socket.io": "^4.8.1",
    "ts-node": "^10.9.2",
