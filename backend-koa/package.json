    "koa-body": "^7.0.0",
    "koa-cors": "^0.0.16",
    "koa-router": "^14.0.0",
    "log4js": "^6.9.1",
    "mysql2": "^3.23.1",
    "nodemailer": "^10.0.9",
    "pm2": "^7.0.2",
    "qiniu": "^7.15.2",
    "qs": "^6.16.0",
    "request": "^2.88.2",
