    "test:remote:integration": "vitest run --config vitest.remote-integration.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "node --env-file=.env.local ./node_modules/nodemon/bin/nodemon.js -r tsconfig-paths/register src/app.ts",
    "env:check": "node --env-file=.env.local -r ts-node/register -r tsconfig-paths/register -e \"require('./src/config/env')\"",
    "start": "node -r ts-node/register -r tsconfig-paths/register src/app.ts"
  },
